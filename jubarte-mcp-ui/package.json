    "mdast-util-from-markdown": "2.1.0",
    "micromark-util-decode-string": "2.0.1",
    "parse5": "7.3.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-remark": "0.7.0",
    "prosemirror-schema-basic": "1.2.5",
